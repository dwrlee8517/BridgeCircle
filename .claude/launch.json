{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "doppler",
      "runtimeArgs": ["run", "-p", "bridgecircle", "-c", "dev_personal", "--", "sh", "-c", "pnpm --dir app install && pnpm --dir app dev"],
      "port": 3001
    },
    {
      "name": "next-dev-local",
      "cwd": "app",
      "runtimeExecutable": "doppler",
      "runtimeArgs": ["run", "-p", "bridgecircle", "-c", "dev_local", "--", "pnpm", "exec", "next", "dev", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "demo-door",
      "cwd": "app",
      "runtimeExecutable": "doppler",
      "runtimeArgs": ["run", "-p", "bridgecircle", "-c", "dev_local", "--", "env", "APP_ENV=local", "DEMO_LOGIN_ENABLED=1", "DEMO_USER_EMAIL=demo-member@example.com", "DEMO_ARM_EMAILS=richard@example.com", "NEXT_PUBLIC_APP_URL=http://localhost:3010", "pnpm", "exec", "next", "dev", "-p", "3010"],
      "port": 3010
    },
    {
      "name": "next-dev-preview",
      "cwd": "app",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "pnpm exec next dev --port $PORT"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "static-docs",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "python3 -m http.server $PORT"],
      "port": 8137,
      "autoPort": true
    },
    {
      "name": "expo-web",
      "cwd": "mobile",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "pnpm exec expo start --web --port $PORT"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
